# Octopus API integration test credentials
#
# Copy this file to .env.test and fill in the values.
# .env.test is gitignored and will not be committed.
#
# Sandbox demo account (request via https://www.octopus.be → "Probeer gratis")
OCTOPUS_USER=your_sandbox_user@D05000000
OCTOPUS_PASSWORD=your_sandbox_password

# Software House ID (request via webservice@octopus.be with company details)
OCTOPUS_SOFTWARE_HOUSE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Dossier ID (find via list_dossiers tool or Octopus interface)
OCTOPUS_DOSSIER_ID=12345
