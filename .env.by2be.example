# Octopus API credentials for the by2-be PRODUCTION dossier.
#
# Copy this file to .env.by2be and fill in the values. .env.by2be is
# gitignored and will not be committed.
#
# Used by ad-hoc investigation scripts (NOT by the automated rspec integration
# suite — that one only talks to the sandbox via .env.test).
#
# Sourced manually before running exploration scripts:
#   set -a; source .env.by2be; set +a; ruby exploration_script.rb

OCTOPUS_USER=your_by2be_user@Dxxxxxxxx
OCTOPUS_PASSWORD=your_by2be_password

# Same Software House ID as .env.test (same Octopus integration partner).
OCTOPUS_SOFTWARE_HOUSE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# by2-be production dossier ID (NOT 49555, which is the sandbox).
OCTOPUS_DOSSIER_ID=12345
